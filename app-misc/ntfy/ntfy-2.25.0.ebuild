RDEPEND="acct-user/${PN}"
DEPEND="${RDEPEND}"
BDEPEND="dev-lang/go"

src_prepare() {
	default

	mv "${WORKDIR}/${PN}-vendor-${PV}/web/node_modules" web || die
	sed -i 's/-m venv/-m venv --system-site-packages/' Makefile || die
}

src_compile() {
	emake web-build
	mkdir -p dist/ntfy_linux_server server/docs
	touch server/docs/index.html server/site/app.html
	CGO_ENABLED=1 ego build \
		-o dist/ntfy_linux_server/ntfy \
		-tags sqlite_omit_load_extension,osusergo,netgo,libsqlite3 \
		-ldflags "-linkmode=external"
}

src_install() {
	dobin dist/ntfy_linux_server/ntfy

	insinto /etc/ntfy
	doins client/client.yml
	doins server/server.yml

	newinitd "${FILESDIR}/${PN}.initd" "${PN}"
	newconfd "${FILESDIR}/${PN}.confd" "${PN}"

	fowners -R root:ntfy /etc/ntfy
	fperms -R o-rwx /etc/ntfy
}
