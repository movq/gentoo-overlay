DESCRIPTION="Music streaming server"
HOMEPAGE="https://github.com/navidrome/navidrome"

SRC_URI="
	https://github.com/navidrome/navidrome/archive/refs/tags/v${PV}.tar.gz -> navidrome-${PV}-gh.tar.gz
	https://git.mjones.io/cgit/mirrors/navidrome-vendor/snapshot/navidrome-vendor-${PV}.tar.xz
	${EGO_SUM_SRC_URI}
"

LICENSE="GPL-2"
SLOT="0"
KEYWORDS="amd64"

RDEPEND="acct-user/${PN}"
DEPEND="${RDEPEND}"
BDEPEND="dev-lang/go"

src_prepare() {
	default
	mv "${WORKDIR}/${PN}-vendor-${PV}/ui/node_modules" ui || die
}

src_compile() {
	emake buildjs || die
	ego build -tags netgo,sqlite_fts5 || die
}

src_install() {
	dobin navidrome
}
